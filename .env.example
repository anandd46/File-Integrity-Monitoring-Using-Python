# Copy to ".env" and edit. NEVER commit the real .env file.

# Secret used to sign session cookies and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per process (sessions reset on restart).
FIM_SECRET_KEY=

# Bind address. Keep 127.0.0.1 (localhost only). Exposing the app to other
# machines needs extra hardening (authentication, HTTPS, reverse proxy).
FIM_HOST=127.0.0.1
FIM_PORT=5000

# Optional overrides for storage locations.
# FIM_DATABASE=data/fim.sqlite3
# FIM_LOG_DIR=logs
# FIM_EXPORT_DIR=exports

# Set to 1 only when serving over HTTPS (marks the session cookie "Secure").
FIM_COOKIE_SECURE=0

# Scanner safety limits.
# FIM_MAX_FILES=20000
# FIM_MAX_FILE_SIZE=536870912
